# ---------------------------------------------------------------------------
# Copy this file to .env and fill it in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Admin API -------------------------------------------------------------
PORT=3001
# Any request to a non-health endpoint must send: Authorization: Bearer <this>
ADMIN_API_KEY=change-me-to-a-long-random-string

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=info
# "json" for machine-readable logs. Lambda switches to json automatically.
LOG_FORMAT=pretty

# --- LLM (Section 9: ChatGPT is the brain) ---------------------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...
# Only needed for a proxy, Azure OpenAI, or Ollama (http://localhost:11434)
# LLM_BASE_URL=

# --- Storage ---------------------------------------------------------------
# "json"   -> ./data/*.json, good for local dev and tests
# "dynamo" -> DynamoDB, required on Lambda because its disk is throwaway
#
# These are two separate memories. If you publish for real from here while
# this says json, the scheduled Lambda cannot see that post: both sides then
# reuse the same opening styles and meme templates, and the same story can go
# out twice. That already happened once.
#
# So publishing live with json is refused. Either switch this to dynamo and
# run `npm run store:migrate -- --confirm` to bring your local history over,
# or set the flag below to accept the split on purpose.
STORE_DRIVER=json
ALLOW_JSON_STORE_FOR_LIVE_POSTS=false
DYNAMO_TABLE=linkedin-tech-meme-agent
AWS_REGION=ap-south-1

# --- LinkedIn --------------------------------------------------------------
# "linkedin" posts for real. "console" prints the post and publishes nothing.
PUBLISHER=console

# From your app at https://www.linkedin.com/developers/apps (Auth tab).
# Register LINKEDIN_REDIRECT_URI there as an authorized redirect URL, exactly.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:4000/callback

# LinkedIn switches off old API versions after about a year. If posting starts
# failing with "426 NONEXISTENT_VERSION", set a newer one here. Note that not
# every month is active, so try a few (202608 works, 202609 does not).
LINKEDIN_API_VERSION=202608

# Filled in for you by `npm run linkedin:auth`. Do not edit these by hand.
# The access token expires after 60 days; re-run that command to renew it.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_MEMBER_ID=

# --- Meme images -----------------------------------------------------------
# Small credit line at the bottom of every meme. Empty = no line.
# Note the post text has no article link either, so empty means nothing
# credits the source.
MEME_FOOTER=

# --- Behaviour -------------------------------------------------------------
# true = build the post but never publish. Leave this on until you are happy.
DRY_RUN=true
# Cron days/times. Default: Tue/Wed/Thu 09:30 in Asia/Kolkata.
SCHEDULE_CRON=30 9 * * 2,3,4
SCHEDULE_TIMEZONE=Asia/Kolkata
POSTS_PER_WEEK=3
